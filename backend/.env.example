HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified
# Machine authentication for the import API (backend/src/policies/require-import-token.ts).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never commit a real value. Required in every environment where the import API is used.
IMPORT_API_TOKEN=tobemodified
# Server-to-server secret for the paid-traffic lookup endpoint
# (backend/src/api/store/controllers/store.ts -> paidTrafficConfig).
# Generate a unique random secret with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty to disable the paid-traffic lookup endpoint (fails closed).
# The same value must be set in the frontend environment (server-side only).
# Never commit a real value.
PAID_TRAFFIC_LOOKUP_SECRET=
