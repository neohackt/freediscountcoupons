{
  "kind": "collectionType",
  "collectionName": "stores",
  "info": {
    "singularName": "store",
    "pluralName": "stores",
    "displayName": "Store",
    "description": "Brand/Store information"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "name": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "name",
      "required": true
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "description": {
      "type": "text"
    },
    "description_html": {
      "type": "text"
    },
    "faqs": {
      "type": "json"
    },
    "website_url": {
      "type": "string"
    },
    "affiliate_url": {
      "type": "string"
    },
    "paid_traffic_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Allow approved paid traffic (Offer18) to redirect visitors through this store's tracking URL. Disabled by default."
    },
    "paid_traffic_tracking_url": {
      "type": "text",
      "description": "Brand-provided affiliate tracking URL template. Supported macros: {tid}, {aff_id}, {offerid}."
    },
    "paid_traffic_sources": {
      "type": "json",
      "description": "Allowed paid traffic sources. Only the generic value \"paid\" is supported."
    },
    "country": {
      "type": "string",
      "maxLength": 2,
      "description": "ISO 3166-1 alpha-2 country code (e.g., IN, US, GB)"
    },
    "currency": {
      "type": "string",
      "maxLength": 3,
      "description": "ISO 4217 currency code (e.g., INR, USD, GBP)"
    },
    "is_popular": {
      "type": "boolean",
      "default": false
    },
    "is_featured": {
      "type": "boolean",
      "default": false
    },
    "categories": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::category.category",
      "inversedBy": "stores"
    },
    "coupons": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::coupon.coupon",
      "mappedBy": "store"
    },
    "seo_title": {
      "type": "string"
    },
    "seo_description": {
      "type": "text"
    },
    "og_image": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    },
    "noindex": {
      "type": "boolean",
      "default": false
    },
    "aliases": {
      "type": "json"
    }
  }
}