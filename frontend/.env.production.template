# Frontend Production Environment
# Copy to frontend/.env.production

# Strapi Backend API URL
NEXT_PUBLIC_STRAPI_URL=https://api.freediscountcoupons.com

# Site URLs (used for canonical, sitemap, OG tags)
NEXT_PUBLIC_SITE_URL=https://freediscountcoupons.com
NEXT_PUBLIC_APP_URL=https://freediscountcoupons.com

# Revalidation secret (must match backend REVALIDATE_SECRET)
REVALIDATE_SECRET=your-revalidate-secret-shared-with-backend

# Paid-traffic lookup secret (server-side only, NEVER NEXT_PUBLIC_)
# Must match backend PAID_TRAFFIC_LOOKUP_SECRET. Leave empty to disable.
PAID_TRAFFIC_LOOKUP_SECRET=

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_CLARITY_ID=
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=